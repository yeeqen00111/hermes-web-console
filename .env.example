# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）

# Hermes dashboard 地址（本机部署默认；远程填 http://<服务器IP>:8426）
HERMES_BASE=http://localhost:8426

# dashboard 登录账号（basic provider）
HERMES_USER=admin
HERMES_PASS=

# 前端令牌（不设则每次后端启动随机生成）
# APP_TOKEN=

# 你的系统前端账号（/api/login；APP_AUTH=1 时启用校验）
# APP_USER=admin
# APP_PASS=secret
# APP_AUTH=
