# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交；docker compose 也读本文件）

# ── 必填 ─────────────────────────────────────────────────────────────
# Hermes dashboard 地址（本机部署默认；远程填 http://<服务器IP>:8426）
# 与 Hermes 同机一体部署（docker-compose.with-hermes.yml）时填 http://127.0.0.1:9119
HERMES_BASE=http://localhost:8426

# dashboard 登录账号 / 密码（basic provider；一体部署时这组同时喂给 dashboard）
HERMES_USER=admin
HERMES_PASS=

# ── docker compose 可选 ──────────────────────────────────────────────
# 镜像标签与宿主端口
# TAG=v0.3
# PORT=8000

# ── 仅 docker-compose.with-hermes.yml 需要 ───────────────────────────
# 容器内 hermes 用户的 uid/gid，对齐宿主上 ~/.hermes 的属主（Linux：$(id -u) / $(id -g)）
# HERMES_UID=10000
# HERMES_GID=10000
# OpenAI 兼容 API server 的 key（不上 API server 就把 compose 里那三行一起注释掉）
# API_SERVER_KEY=

# ── 后端自身的可选开关（见 backend/config.py）────────────────────────
# 前端令牌（不设则每次后端启动随机生成）
# APP_TOKEN=

# 你的系统前端账号（/api/login；APP_AUTH=1 时启用校验）
# APP_USER=admin
# APP_PASS=secret
# APP_AUTH=
