# hermes-deploy 运行配置（gitignore，不提交）
# 两份 compose 都读这个文件：docker-compose.mcp.yml / docker-compose.with-hermes.yml
# 变量分三类：① 控制台与 dashboard 共用 ② hermes-mcp 用 ③ 编排层用（端口/网络/入口）

# ── ① 控制台 + dashboard（一组账号两处用）─────────────────────────────
# 谁读：backend/config.py（控制台登录 dashboard 用它做 basic auth；控制台自己也是这套）
# 注意：with-hermes 那份里同一组值也喂给 dashboard 的 BASIC_AUTH，改一处两边都变
HERMES_USER=admin
HERMES_PASS=

# 控制台连 dashboard 的地址（控制台启动时读它）
#   两份 stack 值不同，用两个 env 文件区分：
#     .env       -> http://gateway:9119        给 with-hermes（容器内用服务名）
#     .env.mcp   -> http://127.0.0.1:8426      给 mcp 那份（没有 Hermes，连不上是预期）
HERMES_BASE=http://gateway:9119

# ── 在 Hermes 上注册问数 MCP 时填什么（两行对照）──────────────────────
#   名称：sql-coustm（与 .env 的 MCP_SERVER_NAME 保持一致）
#   地址：http://hermes-mcp:9123/mcp
#     host 必须是 **service 名** hermes-mcp —— 同一 network 内由 Docker DNS 解析。
#     不能用 localhost/127.0.0.1（那是 Hermes 容器自己）；也不能用宿主 IP
#     （mcp 在 bridge 网络里、没往宿主映射端口）。既有的 metaso 条目就是同形态。
# Hermes 上注册的 MCP 服务名（问数页靠它标记哪条是问数服务）
# 谁读：backend/config.py（MCP_SERVER_NAME）
MCP_SERVER_NAME=sql-coustm

# 控制台访问问数服务的**唯一出口**（2026-10-20 起控制台不再直读共享 SQLite）
# 谁读：backend/config.py（HERMESMCP_URL）→ backend/mcp_client.py
#   compose 的 environment: 里已按服务名给了默认值（environment 覆盖 env_file），
#   所以跑容器**不用**在这里填；只有本机直接起后端时才需要。
#   ⚠️ 本机开发别写 127.0.0.1 —— 实测 MCP 只监听 LAN 口，回环连不上。
HERMESMCP_URL=http://hermes-mcp:9123/mcp

# ── ② hermes-mcp 自己的存储（**控制台不再读写**）──────────────────────
# 谁读：**只有** hermes-mcp/src/hermes_mcp/config.py
# 数据源注册表（+ 知识库/模板）都在 mcp 侧；控制台只通过 MCP 工具访问，不碰这些文件。
# 容器里路径固定为 /shared/db_connections.db（compose 把 ./shared/sqlite 挂到这里）。
HERMESMCP_DB_CONFIG=/shared/db_connections.db
# 生成一把：python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
HERMESMCP_DB_KEY=

# ── ③ hermes-mcp：NL→SQL 生成模型（不填则 ask 不可用，query 等工具照常）──
# 谁读：hermes-mcp/src/hermes_mcp/config.py（load_settings）
# BASE_URL 是 OpenAI 兼容端点、不要带 /chat/completions（代码自己拼）
HERMESMCP_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
HERMESMCP_LLM_API_KEY=
HERMESMCP_LLM_MODEL=glm-5.3-flash

# ── ④ hermes-mcp：HTTP 传输（compose 里已给默认值，通常不用改）────────
# 谁读：hermes-mcp/scripts/run_http.py
# 白名单是**前缀匹配**，请求头带端口 → 必须写 `服务名:*`，只写服务名不通过
# HERMESMCP_HOST=0.0.0.0
# HERMESMCP_PORT=9123
# HERMESMCP_ALLOWED_HOSTS=hermes-mcp:*,localhost:*,127.0.0.1:*

# ── ⑤ 编排层（docker compose 自己用）──────────────────────────────────
# 控制台对外端口
# PORT=8000
# 内部镜像标签（本地构建时用不到）
# TAG=latest

# ── ⑥ 仅 with-hermes 那份：Hermes 容器 ────────────────────────────────
# 对齐宿主 ~/.hermes 属主（Linux：$(id -u) / $(id -g)）
# HERMES_UID=10000
# HERMES_GID=10000
# OpenAI 兼容 API server（8642）。默认关：前端永不直连它。
# 要开：设了下面的 key，并把 compose 里对应的三行取消注释。
# API_SERVER_KEY=

# ── ⑦ 控制台后端自身的可选开关（默认全关）────────────────────────────
# 谁读：backend/config.py
# 前端令牌；不设则每次后端启动随机生成
# APP_TOKEN=
# 前端账号（/api/login）；只有 APP_AUTH=1 时才启用校验
# APP_USER=admin
# APP_PASS=secret
# APP_AUTH=
